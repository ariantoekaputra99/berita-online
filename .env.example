# Scheduled scrape (production only; set in Vercel, never commit real values)
# CRON_SECRET=            # Vercel Cron sends it as "Authorization: Bearer <value>"
# SCRAPER_BOT_EMAIL=      # dedicated Supabase user with role 'admin' (no service-role key needed)
# SCRAPER_BOT_PASSWORD=

# Automatic AI briefs for scraped drafts (optional; without it the feature stays off)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Hourly scheduler (Supabase pg_cron -> /api/cron/scrape) and Telegram bot (all optional; set in Vercel only)
# AUTOMATION_SECRET=            # random string, same value used in supabase/ops/schedule-hourly.sql
# TELEGRAM_BOT_TOKEN=           # from @BotFather
# TELEGRAM_WEBHOOK_SECRET=      # random string, also passed as secret_token to setWebhook
# TELEGRAM_ALLOWED_CHAT_IDS=    # comma separated chat ids allowed to command the bot / receive notifications
